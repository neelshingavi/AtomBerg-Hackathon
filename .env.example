# Copy to .env.local (local) or set in Vercel → Settings → Environment Variables.

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Local (docker compose):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atomquest?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/atomquest?schema=public"

# Supabase / Neon (production) — use pooler for DATABASE_URL, direct for DIRECT_URL:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── NEXTAUTH / AUTH.JS ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Production: set to your Vercel URL, e.g. https://atomgoal.vercel.app

# ─── AZURE AD (optional — leave empty to disable) ─────────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ─── EMAIL (RESEND) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="AtomGoal <noreply@yourdomain.com>"

# ─── MICROSOFT TEAMS (optional) ───────────────────────────────────────────────
TEAMS_WEBHOOK_URL=""

# ─── CRON ─────────────────────────────────────────────────────────────────────
CRON_SECRET=""

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="AtomGoal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" when Azure AD env vars are configured
NEXT_PUBLIC_AZURE_AD_ENABLED="false"
# Enable demo mode UI (role switcher, guided tour) — auto-enabled in development
NEXT_PUBLIC_DEMO_MODE="false"

# ─── ATOM AI COPILOT (optional — enhances natural language polish) ─────────────
# Without OPENAI_API_KEY, copilot uses deterministic data-driven reasoning.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
